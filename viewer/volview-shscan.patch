+<script setup lang="ts">
+// Al Shrooouk Scan: dental workspace (panoramic curve, cross-sections, nerve
+// tracing, measurements and image processing) built on the loaded CBCT
+// volume. Everything is computed on the CPU from the voxel data VolView has
+// already loaded, in index space (CBCT voxels are isotropic in-plane).
+import { ref, shallowRef, markRaw, computed, watch, onMounted, onBeforeUnmount, nextTick } from 'vue';
+import { useCurrentImage } from '@/src/composables/useCurrentImage';
+
+const emit = defineEmits(['close']);
+const { currentImageData } = useCurrentImage('global');
+
+// ---------------------------------------------------------------- volume
+type Vol = {
+  data: ArrayLike<number>; nx: number; ny: number; nz: number;
+  sx: number; sz: number; flipX: boolean; flipY: boolean; topIsK0: boolean;
+  lo: number; hi: number;
+};
+const vol = shallowRef<Vol | null>(null);
+const status = ref('');
+
+function loadVolume() {
+  const im: any = currentImageData.value;
+  if (!im) { status.value = 'Open a scan first.'; vol.value = null; return; }
+  const [nx, ny, nz] = im.getDimensions();
+  const sp = im.getSpacing();
+  const d = im.getDirection();
+  const data = im.getPointData().getScalars().getData();
+  // direction is column-major in vtk.js: column 2 (indices 6..8) is the k axis
+  const topIsK0 = d[8] < 0;
+  // percentiles for auto window
+  const step = Math.max(1, Math.floor(data.length / 200000));
+  const sample: number[] = [];
+  for (let i = 0; i < data.length; i += step) sample.push(data[i]);
+  sample.sort((a, b) => a - b);
+  const lo = sample[Math.floor(sample.length * 0.02)];
+  const hi = sample[Math.floor(sample.length * 0.997)];
+  vol.value = markRaw({ data, nx, ny, nz, sx: sp[0], sz: sp[2], flipX: d[0] < 0, flipY: d[4] < 0, topIsK0, lo, hi });
+  win.value = Math.round(hi - lo);
+  lev.value = Math.round((hi + lo) / 2);
+  axialK.value = Math.round(nz * 0.5);
+  status.value = '';
+}
+
+// ---------------------------------------------------------------- state
+const mode = ref<'arch' | 'pick' | 'nerveR' | 'nerveL' | 'measure'>('arch');
+const axialK = ref(0);
+const win = ref(2000);
+const lev = ref(500);
+const slabMm = ref(10);
+const slabMip = ref(false);
+const sharpen = ref(0.6);
+const denoise = ref(true);
+const invert = ref(false);
+const csGapMm = ref(1);
+const csHalfMm = ref(15);
+const nerveDiaMm = ref(2.5);
+// Panoramic tilt (Mohamed Said, 10 Nov 2026), in degrees:
+//   tiltBL: the panoramic surface leans buccal/lingual around the arch level
+//   tiltFB / tiltLR: the reference (occlusal) plane tilts front-back / left-right
+const tiltBL = ref(0);
+const tiltFB = ref(0);
+const tiltLR = ref(0);
+const archK = ref<number | null>(null); // axial slice the arch was drawn on (tilt pivot)
+// Cross-section tilt (Mohamed Said, 10 Nov 2026): the cross-section line on
+// the panoramic leans left/right (mesio-distal) around the point clicked, and
+// the cross-sections follow it, e.g. to line up with a tooth or implant axis.
+const csTilt = ref(0);
+const csPivot = ref<number | null>(null); // panoramic row of the pivot
+
+const archPts = ref<{ i: number; j: number }[]>([]);
+const sSel = ref<number | null>(null); // index along the curve for cross-sections
+type NP = { s: number; t: number; z: number }; // z = panoramic row
+const nerves = ref<{ R: NP[]; L: NP[] }>({ R: [], L: [] });
+// one measurement at a time, on the panoramic or any cross-section
+const measure = ref<{ key: string; a: [number, number] | null; b: [number, number] | null }>({ key: '', a: null, b: null });
+function drawMeasure(ctx: CanvasRenderingContext2D, f: Fit, dpr: number, key: string, v: Vol) {
+  const m = measure.value; if (m.key !== key || !m.a) return;
+  const [ax, ay] = toCanvas(f, m.a[0], m.a[1]);
+  ctx.fillStyle = '#ffeb3b'; ctx.beginPath(); ctx.arc(ax, ay, 3.5 * dpr, 0, Math.PI * 2); ctx.fill();
+  if (!m.b) return;
+  const [bx, by] = toCanvas(f, m.b[0], m.b[1]);
+  ctx.beginPath(); ctx.arc(bx, by, 3.5 * dpr, 0, Math.PI * 2); ctx.fill();
+  ctx.strokeStyle = '#ffeb3b'; ctx.lineWidth = 2 * dpr; ctx.beginPath(); ctx.moveTo(ax, ay); ctx.lineTo(bx, by); ctx.stroke();
+  // columns are 1 voxel of arc length (panoramic) or of width (cross-section); rows are slices
+  const mm = Math.hypot((m.b[0] - m.a[0]) * v.sx, (m.b[1] - m.a[1]) * v.sz);
+  const label = `${mm.toFixed(1)} mm`;
+  ctx.font = `bold ${14 * dpr}px sans-serif`;
+  const tw = ctx.measureText(label).width;
+  ctx.fillStyle = 'rgba(0,0,0,0.65)'; ctx.fillRect(bx + 6 * dpr, by - 22 * dpr, tw + 8 * dpr, 20 * dpr);
+  ctx.fillStyle = '#ffeb3b'; ctx.fillText(label, bx + 10 * dpr, by - 7 * dpr);
+}
+function measureClick(key: string, p: number[]) {
+  const m = measure.value;
+  if (m.key !== key || !m.a || m.b) measure.value = { key, a: [p[0], p[1]], b: null };
+  else measure.value = { ...m, b: [p[0], p[1]] };
+}
+
+const axialCv = ref<HTMLCanvasElement | null>(null);
+const panoCv = ref<HTMLCanvasElement | null>(null);
+const csCvs = [ref<HTMLCanvasElement | null>(null), ref<HTMLCanvasElement | null>(null), ref<HTMLCanvasElement | null>(null)];
+
+// ---------------------------------------------------------------- helpers
+function voxel(v: Vol, i: number, j: number, k: number) {
+  if (i < 0 || j < 0 || i > v.nx - 1 || j > v.ny - 1) return v.lo;
+  const i0 = Math.floor(i), j0 = Math.floor(j);
+  const i1 = Math.min(i0 + 1, v.nx - 1), j1 = Math.min(j0 + 1, v.ny - 1);
+  const fi = i - i0, fj = j - j0;
+  const base = k * v.nx * v.ny;
+  const a = v.data[base + j0 * v.nx + i0], b = v.data[base + j0 * v.nx + i1];
+  const c = v.data[base + j1 * v.nx + i0], e = v.data[base + j1 * v.nx + i1];
+  return (a * (1 - fi) + b * fi) * (1 - fj) + (c * (1 - fi) + e * fi) * fj;
+}
+const kOfRow = (v: Vol, r: number) => (v.topIsK0 ? r : v.nz - 1 - r);
+
+// Catmull-Rom through the arch points, resampled every 1 voxel of arc length.
+const curve = computed(() => {
+  const P = archPts.value;
+  if (P.length < 2) return null;
+  const dense: [number, number][] = [];
+  const at = (n: number) => P[Math.max(0, Math.min(P.length - 1, n))];
+  for (let n = 0; n < P.length - 1; n++) {
+    const p0 = at(n - 1), p1 = at(n), p2 = at(n + 1), p3 = at(n + 2);
+    for (let q = 0; q < 40; q++) {
+      const t = q / 40, t2 = t * t, t3 = t2 * t;
+      const f = (a: number, b: number, c: number, d: number) =>
+        0.5 * (2 * b + (-a + c) * t + (2 * a - 5 * b + 4 * c - d) * t2 + (-a + 3 * b - 3 * c + d) * t3);
+      dense.push([f(p0.i, p1.i, p2.i, p3.i), f(p0.j, p1.j, p2.j, p3.j)]);
+    }
+  }
+  dense.push([P[P.length - 1].i, P[P.length - 1].j]);
+  const xs: number[] = [], ys: number[] = [];
+  let acc = 0, next = 0;
+  for (let n = 1; n < dense.length; n++) {
+    const [x0, y0] = dense[n - 1], [x1, y1] = dense[n];
+    const L = Math.hypot(x1 - x0, y1 - y0);
+    while (next <= acc + L && L > 0) {
+      const f = (next - acc) / L;
+      xs.push(x0 + (x1 - x0) * f); ys.push(y0 + (y1 - y0) * f);
+      next += 1;
+    }
+    acc += L;
+  }
+  const N = xs.length;
+  const nxv: number[] = [], nyv: number[] = [];
+  for (let s = 0; s < N; s++) {
+    const a = Math.max(0, s - 2), b = Math.min(N - 1, s + 2);
+    let tx = xs[b] - xs[a], ty = ys[b] - ys[a];
+    const l = Math.hypot(tx, ty) || 1; tx /= l; ty /= l;
+    nxv.push(-ty); nyv.push(tx);
+  }
+  return { xs, ys, nxv, nyv, N };
+});
+
+// 2D image processing on a float buffer
+function process(buf: Float32Array, w: number, h: number) {
+  let src = buf;
+  if (denoise.value) src = blur(src, w, h);
+  if (sharpen.value > 0) {
+    const b = blur(blur(src, w, h), w, h);
+    const out = new Float32Array(src.length);
+    for (let n = 0; n < src.length; n++) out[n] = src[n] + sharpen.value * (src[n] - b[n]);
+    src = out;
+  }
+  return src;
+}
+function blur(a: Float32Array, w: number, h: number) {
+  const o = new Float32Array(a.length);
+  for (let y = 0; y < h; y++)
+    for (let x = 0; x < w; x++) {
+      let s = 0, c = 0;
+      for (let dy = -1; dy <= 1; dy++) {
+        const yy = y + dy; if (yy < 0 || yy >= h) continue;
+        for (let dx = -1; dx <= 1; dx++) {
+          const xx = x + dx; if (xx < 0 || xx >= w) continue;
+          const wt = dx === 0 && dy === 0 ? 4 : dx === 0 || dy === 0 ? 2 : 1;
+          s += a[yy * w + xx] * wt; c += wt;
+        }
+      }
+      o[y * w + x] = s / c;
+    }
+  return o;
+}
+function toImage(buf: Float32Array, w: number, h: number) {
+  const img = new ImageData(w, h);
+  const lo = lev.value - win.value / 2, sc = 255 / Math.max(1, win.value);
+  for (let n = 0; n < w * h; n++) {
+    let g = (buf[n] - lo) * sc; g = g < 0 ? 0 : g > 255 ? 255 : g;
+    if (invert.value) g = 255 - g;
+    img.data[n * 4] = img.data[n * 4 + 1] = img.data[n * 4 + 2] = g; img.data[n * 4 + 3] = 255;
+  }
+  return img;
+}
+
+// Draws an image into a canvas, fitted, and returns the mapping.
+type Fit = { s: number; ox: number; oy: number; w: number; h: number; ax: number };
+const fits: Record<string, Fit> = {};
+function blit(cv: HTMLCanvasElement | null, key: string, img: ImageData, aspect = 1) {
+  if (!cv) return null;
+  const dpr = window.devicePixelRatio || 1;
+  const cw = cv.clientWidth * dpr, ch = cv.clientHeight * dpr;
+  if (cv.width !== cw || cv.height !== ch) { cv.width = cw; cv.height = ch; }
+  const ctx = cv.getContext('2d')!;
+  ctx.fillStyle = '#000'; ctx.fillRect(0, 0, cw, ch);
+  const off = document.createElement('canvas'); off.width = img.width; off.height = img.height;
+  off.getContext('2d')!.putImageData(img, 0, 0);
+  const s = Math.min(cw / img.width, ch / (img.height * aspect));
+  const ox = (cw - img.width * s) / 2, oy = (ch - img.height * aspect * s) / 2;
+  ctx.imageSmoothingEnabled = true;
+  ctx.drawImage(off, ox, oy, img.width * s, img.height * aspect * s);
+  const f = { s, ox, oy, w: img.width, h: img.height, ax: aspect };
+  fits[key] = f;
+  return { ctx, f, dpr };
+}
+const toCanvas = (f: Fit, x: number, y: number) => [f.ox + x * f.s, f.oy + y * f.ax * f.s];
+function fromEvent(cv: HTMLCanvasElement, key: string, e: MouseEvent) {
+  const f = fits[key]; if (!f) return null;
+  const r = cv.getBoundingClientRect(); const dpr = window.devicePixelRatio || 1;
+  const x = ((e.clientX - r.left) * dpr - f.ox) / f.s;
+  const y = ((e.clientY - r.top) * dpr - f.oy) / (f.s * f.ax);
+  return [x, y];
+}
+
+// axial display coords <-> index coords (radiological view, anterior up)
+const axToIdx = (v: Vol, x: number, y: number) => ({ i: v.flipX ? v.nx - 1 - x : x, j: v.flipY ? v.ny - 1 - y : y });
+const idxToAx = (v: Vol, i: number, j: number) => [v.flipX ? v.nx - 1 - i : i, v.flipY ? v.ny - 1 - j : j];
+
+// ---------------------------------------------------------------- nerves
+function nerveAt(pts: NP[], s: number): { t: number; z: number } | null {
+  if (pts.length < 2) return null;
+  const P = [...pts].sort((a, b) => a.s - b.s);
+  if (s < P[0].s || s > P[P.length - 1].s) return null;
+  for (let n = 1; n < P.length; n++)
+    if (s <= P[n].s) {
+      const f = (s - P[n - 1].s) / Math.max(1e-6, P[n].s - P[n - 1].s);
+      return { t: P[n - 1].t + (P[n].t - P[n - 1].t) * f, z: P[n - 1].z + (P[n].z - P[n - 1].z) * f };
+    }
+  return null;
+}
+const NERVE_COL = { R: '#ff4d4d', L: '#ffb020' };
+
+// ---------------------------------------------------------------- render
+function drawAxial() {
+  const v = vol.value; const cv = axialCv.value; if (!v || !cv) return;
+  const k = Math.max(0, Math.min(v.nz - 1, axialK.value));
+  const { nx, ny, data, flipX, flipY } = v;
+  const buf = new Float32Array(nx * ny);
+  const base = k * nx * ny;
+  for (let y = 0; y < ny; y++) {
+    const j = flipY ? ny - 1 - y : y, row = base + j * nx, out = y * nx;
+    if (flipX) for (let x = 0; x < nx; x++) buf[out + x] = data[row + nx - 1 - x];
+    else for (let x = 0; x < nx; x++) buf[out + x] = data[row + x];
+  }
+  const r = blit(cv, 'ax', toImage(buf, v.nx, v.ny)); if (!r) return;
+  const { ctx, f, dpr } = r;
+  const c = curve.value;
+  if (c) {
+    ctx.strokeStyle = '#3fd0ff'; ctx.lineWidth = 2 * dpr; ctx.beginPath();
+    c.xs.forEach((xi, n) => { const [ax, ay] = idxToAx(v, xi, c.ys[n]); const [px, py] = toCanvas(f, ax, ay); n ? ctx.lineTo(px, py) : ctx.moveTo(px, py); });
+    ctx.stroke();
+    if (sSel.value != null) {
+      const s = Math.round(sSel.value), half = csHalfMm.value / v.sx;
+      const gap = csGapMm.value / v.sx;
+      [-gap, 0, gap].forEach((dg, idx) => {
+        const rA = v.topIsK0 ? k : v.nz - 1 - k;
+        const ss = Math.max(0, Math.min(c.N - 1, Math.round(sAt(v, s + dg, rA))));
+        const [a1, b1] = idxToAx(v, c.xs[ss] - c.nxv[ss] * half, c.ys[ss] - c.nyv[ss] * half);
+        const [a2, b2] = idxToAx(v, c.xs[ss] + c.nxv[ss] * half, c.ys[ss] + c.nyv[ss] * half);
+        const [p1, q1] = toCanvas(f, a1, b1), [p2, q2] = toCanvas(f, a2, b2);
+        ctx.strokeStyle = idx === 1 ? '#7CFC00' : 'rgba(124,252,0,0.5)'; ctx.lineWidth = (idx === 1 ? 2 : 1) * dpr;
+        ctx.beginPath(); ctx.moveTo(p1, q1); ctx.lineTo(p2, q2); ctx.stroke();
+      });
+    }
+    (['R', 'L'] as const).forEach((side) => {
+      const pts = nerves.value[side]; if (pts.length < 2) return;
+      const P = [...pts].sort((a, b) => a.s - b.s);
+      ctx.strokeStyle = NERVE_COL[side]; ctx.lineWidth = 2 * dpr; ctx.beginPath();
+      let first = true;
+      for (let s = Math.ceil(P[0].s); s <= P[P.length - 1].s && s < c.N; s++) {
+        const nz = nerveAt(P, s); if (!nz) continue;
+        const [ax, ay] = idxToAx(v, c.xs[s] + c.nxv[s] * nz.t, c.ys[s] + c.nyv[s] * nz.t);
+        const [px, py] = toCanvas(f, ax, ay); first ? ctx.moveTo(px, py) : ctx.lineTo(px, py); first = false;
+      }
+      ctx.stroke();
+    });
+  }
+  archPts.value.forEach((p) => {
+    const [ax, ay] = idxToAx(v, p.i, p.j); const [px, py] = toCanvas(f, ax, ay);
+    ctx.fillStyle = '#3fd0ff'; ctx.beginPath(); ctx.arc(px, py, 5 * dpr, 0, Math.PI * 2); ctx.fill();
+  });
+  ctx.fillStyle = '#fff'; ctx.font = `${12 * dpr}px sans-serif`;
+  ctx.fillText(`Axial ${k + 1}/${v.nz}`, 8 * dpr, 18 * dpr);
+  ctx.fillText('A', cv.width / 2, 16 * dpr); ctx.fillText('R', 6 * dpr, cv.height / 2);
+}
+
+// Row shift per curve sample for the occlusal-plane tilt (rows = slices).
+function tiltRows(v: Vol, c: any) {
+  const out = new Float32Array(c.N);
+  const tf = Math.tan((tiltFB.value * Math.PI) / 180), tl = Math.tan((tiltLR.value * Math.PI) / 180);
+  if (!tf && !tl) return out;
+  let ic = 0, jc = 0;
+  for (let s = 0; s < c.N; s++) { ic += c.xs[s]; jc += c.ys[s]; }
+  ic /= c.N; jc /= c.N;
+  const f = v.sx / v.sz;
+  for (let s = 0; s < c.N; s++) out[s] = (tf * (c.ys[s] - jc) + tl * (c.xs[s] - ic)) * f;
+  return out;
+}
+const pivotRow = (v: Vol) => { const k = archK.value ?? Math.round(v.nz / 2); return v.topIsK0 ? k : v.nz - 1 - k; };
+// Buccal/lingual offset (in-plane voxels) of the panoramic surface at row r.
+const surfOffset = (v: Vol, r: number) => Math.tan((tiltBL.value * Math.PI) / 180) * (r - pivotRow(v)) * (v.sz / v.sx);
+const pivotOf = (v: Vol) => csPivot.value ?? v.nz / 2;
+// curve position of the cross-section plane at panoramic row r
+const sAt = (v: Vol, s0: number, r: number) => s0 + Math.tan((csTilt.value * Math.PI) / 180) * (r - pivotOf(v)) * (v.sz / v.sx);
+const rowK = (v: Vol, r: number) => { const rr = Math.max(0, Math.min(v.nz - 1, Math.round(r))); return v.topIsK0 ? rr : v.nz - 1 - rr; };
+
+let panoBuf: { buf: Float32Array; w: number; h: number } | null = null; // processed
+let panoRaw: { buf: Float32Array; w: number; h: number; key: string } | null = null; // before filters
+let panoImg: ImageData | null = null;
+// Build the raw panoramic. Bilinear taps are worked out once per (s, t)
+// and reused for every slice, so the inner loop is plain array reads.
+function buildPanoRaw(preview = false) {
+  const v = vol.value, c = curve.value;
+  if (!v || !c) { panoRaw = null; return; }
+  const half = Math.max(0, Math.round(slabMm.value / v.sx / 2));
+  const key = `${c.N}|${c.xs[0]}|${c.xs[c.N - 1]}|${c.ys[(c.N / 2) | 0]}|${archPts.value.length}|${half}|${slabMip.value}|${preview}|${tiltBL.value}|${tiltFB.value}|${tiltLR.value}|${archK.value}`;
+  if (panoRaw && panoRaw.key === key) return;
+  const { data, nx, ny, nz } = v;
+  const lo = v.lo, plane = nx * ny;
+  const tStep = preview ? Math.max(1, Math.round(half / 3)) : 1; // fewer slab samples while dragging
+  const rStep = preview ? 2 : 1;
+  const w = c.N, h = nz;
+  // taps: for each (s, t) -> 4 offsets + 4 weights (offset -1 = outside)
+  const ts: number[] = [];
+  for (let t = -half; t <= half; t += tStep) ts.push(t);
+  const T = ts.length, M = w * T;
